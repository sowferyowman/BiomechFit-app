{
  "expo": {
    "name": "frontend-app",
    "slug": "frontend-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "frontendapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.frontendapp"
    },
    "web": {
      "output": "single"
    },
    "plugins": [],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e1257312-df5e-4685-8db5-77684717bf4b"
      }
    },
    "owner": "stanlyfranciscoexpos-organization"
  }
}
